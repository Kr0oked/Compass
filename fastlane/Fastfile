require "open3"

default_platform(:android)

ANDROID_SDK_ROOT_PATH = ENV["ANDROID_SDK_ROOT"] || ENV["ANDROID_HOME"] || File.expand_path("~/Android/Sdk")
EMULATOR_BIN = File.join(ANDROID_SDK_ROOT_PATH, "emulator", "emulator")
ADB_BIN = File.join(ANDROID_SDK_ROOT_PATH, "platform-tools", "adb")
AVDMANAGER_BIN = File.join(ANDROID_SDK_ROOT_PATH, "cmdline-tools", "latest", "bin", "avdmanager")
SDKMANAGER_BIN = File.join(ANDROID_SDK_ROOT_PATH, "cmdline-tools", "latest", "bin", "sdkmanager")
AVD_BASE_DEVICE = "pixel"
AVD_SYSTEM_IMAGE = "system-images;android-37.0;google_apis;x86_64"
# Android 17 (API 37) emulators require at least 4GB of RAM.
AVD_RAM_SIZE_MB = 4096
EMULATOR_BOOT_TIMEOUT_SECONDS = 600
EMULATOR_SHUTDOWN_TIMEOUT_SECONDS = 60

SCREENSHOT_EMULATORS = [
  { avd: "Screenshots_Phone", port: 5554, device_type: "phone", lcd_width: 1080, lcd_height: 1920, lcd_density: 480 },
  { avd: "Screenshots_SevenInch", port: 5556, device_type: "sevenInch", lcd_width: 1440, lcd_height: 2560, lcd_density: 480 },
  { avd: "Screenshots_TenInch", port: 5558, device_type: "tenInch", lcd_width: 2160, lcd_height: 3840, lcd_density: 480 }
].map { |device| device.merge(serial: "emulator-#{device[:port]}") }.freeze

TEST_EMULATOR = { avd: "Test_Phone", port: 5560, serial: "emulator-5560" }.freeze

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")

    ensure_sdk_command_line_tools_available
    ensure_system_image_installed
    create_avd_if_missing(TEST_EMULATOR)
    boot_emulator(TEST_EMULATOR)
    begin
      gradle(task: "connectedAndroidTest")
    ensure
      shutdown_emulator(TEST_EMULATOR)
    end
  end

  desc "Build a new APK"
  lane :apk do
    gradle(task: "clean")
    gradle(
      task: "assembleRelease",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
      }
    )
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean")
    gradle(
      task: "bundleRelease",
      print_command: false,
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_FILE"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
      }
    )
    upload_to_play_store(
      json_key: ENV["ANDROID_JSON_KEY_FILE"]
    )
  end

  desc "Grab phone screenshots"
  lane :grab_screen_phone do
    capture_device_screenshots(device_type: "phone")
  end

  desc "Grab seven inch screenshots"
  lane :grab_screen_seven_inch do
    capture_device_screenshots(device_type: "sevenInch")
  end

  desc "Grab ten inch screenshots"
  lane :grab_screen_ten_inch do
    capture_device_screenshots(device_type: "tenInch")
  end

  desc "Grab all screenshots, booting each screenshot emulator in turn"
  lane :grab_screens do
    setup_screenshot_emulators
    SCREENSHOT_EMULATORS.each do |emulator|
      boot_emulator(emulator)
      begin
        capture_device_screenshots(device_type: emulator[:device_type], specific_device: emulator[:serial])
      ensure
        shutdown_emulator(emulator)
      end
    end
  end

  desc "Create the Screenshots_* AVDs on this machine if they don't already exist"
  lane :setup_screenshot_emulators do
    ensure_sdk_command_line_tools_available
    ensure_system_image_installed
    SCREENSHOT_EMULATORS.each { |emulator| create_avd_if_missing(emulator) }
  end

  desc "Regenerate featureGraphic.png for every fastlane locale from the app icon, theme colors and translated app name"
  lane :generate_feature_graphics do
    sh("python3 \"#{File.join(__dir__, 'generate_feature_graphics.py')}\"")
  end

  private_lane :ensure_sdk_command_line_tools_available do
    unless File.exist?(AVDMANAGER_BIN) && File.exist?(SDKMANAGER_BIN)
      UI.user_error!(
        "avdmanager/sdkmanager not found under #{File.dirname(AVDMANAGER_BIN)}. " \
        "Install them once via Android Studio: SDK Manager > SDK Tools tab > " \
        "\"Android SDK Command-line Tools (latest)\"."
      )
    end
  end

  private_lane :ensure_system_image_installed do
    image_dir = File.join(ANDROID_SDK_ROOT_PATH, *AVD_SYSTEM_IMAGE.split(";"))
    unless Dir.exist?(image_dir)
      UI.message("System image #{AVD_SYSTEM_IMAGE} not found, installing...")
      sh("yes | \"#{SDKMANAGER_BIN}\" --licenses > /dev/null")
      sh("\"#{SDKMANAGER_BIN}\" --install \"#{AVD_SYSTEM_IMAGE}\"")
    end
  end

  private_lane :create_avd_if_missing do |options|
    avd_dir = File.join(Dir.home, ".android", "avd", "#{options[:avd]}.avd")
    unless Dir.exist?(avd_dir)
      UI.message("Creating AVD #{options[:avd]}...")
      sh("echo no | \"#{AVDMANAGER_BIN}\" create avd " \
         "-n #{options[:avd]} -k \"#{AVD_SYSTEM_IMAGE}\" -d #{AVD_BASE_DEVICE} --force")

      config_path = File.join(avd_dir, "config.ini")
      sed_edits = ["-e 's/^hw.ramSize=.*/hw.ramSize=#{AVD_RAM_SIZE_MB}/'"]
      sed_edits << "-e 's/^hw.lcd.width=.*/hw.lcd.width=#{options[:lcd_width]}/'" if options[:lcd_width]
      sed_edits << "-e 's/^hw.lcd.height=.*/hw.lcd.height=#{options[:lcd_height]}/'" if options[:lcd_height]
      sed_edits << "-e 's/^hw.lcd.density=.*/hw.lcd.density=#{options[:lcd_density]}/'" if options[:lcd_density]
      sh("sed -i #{sed_edits.join(' ')} \"#{config_path}\"")
    end
  end

  private_lane :capture_device_screenshots do |options|
    gradle(task: "assemble", build_type: "Debug")
    gradle(task: "assemble", build_type: "AndroidTest")
    screengrab(
      device_type: options[:device_type],
      specific_device: options[:specific_device],
      clear_previous_screenshots: true
    )
  end

  private_lane :boot_emulator do |options|
    serial = options[:serial]
    log_path = "/tmp/#{options[:avd]}-emulator.log"
    UI.message("Booting #{options[:avd]} (#{serial}), log: #{log_path}...")
    # Own process group, so a Ctrl+C meant for fastlane doesn't also reach the emulator; shutdown_emulator stops it.
    pid = Process.spawn(EMULATOR_BIN, "-avd", options[:avd], "-port", options[:port].to_s, "-no-snapshot-save",
                        out: log_path, err: [:child, :out], pgroup: true)
    Process.detach(pid)

    deadline = Time.now + EMULATOR_BOOT_TIMEOUT_SECONDS
    until adb_getprop(serial, "sys.boot_completed") == "1" && adb_getprop(serial, "init.svc.bootanim") == "stopped"
      unless process_alive?(pid)
        UI.user_error!("Emulator #{options[:avd]} exited before finishing boot. Last lines of #{log_path}:\n" \
                       "#{log_tail(log_path)}")
      end
      if Time.now > deadline
        Process.kill("KILL", pid) rescue nil
        UI.user_error!("Emulator #{options[:avd]} did not finish booting within #{EMULATOR_BOOT_TIMEOUT_SECONDS}s " \
                       "and was killed. Check `adb -s #{serial} logcat -b crash` on the next attempt for a " \
                       "crash-looping system image. Last lines of #{log_path}:\n#{log_tail(log_path)}")
      end
      sleep(2)
    end

    sh("\"#{ADB_BIN}\" -s #{serial} shell input keyevent KEYCODE_WAKEUP")
    sh("\"#{ADB_BIN}\" -s #{serial} shell wm dismiss-keyguard")
  end

  private_lane :shutdown_emulator do |options|
    serial = options[:serial]
    UI.message("Shutting down #{serial}...")
    sh("timeout 10 \"#{ADB_BIN}\" -s #{serial} emu kill || true")
    deadline = Time.now + EMULATOR_SHUTDOWN_TIMEOUT_SECONDS
    while adb_device_listed?(serial)
      if Time.now > deadline
        UI.important("#{serial} still listed by adb after #{EMULATOR_SHUTDOWN_TIMEOUT_SECONDS}s, giving up waiting.")
        break
      end
      sleep(1)
    end
  end

end

# Each adb call is capped by `timeout`, since adb can block indefinitely on a half-started or offline emulator.
def adb_getprop(serial, property)
  output, status = Open3.capture2e("timeout", "10", ADB_BIN, "-s", serial, "shell", "getprop", property)
  status.success? ? output.strip : nil
end

def adb_device_listed?(serial)
  output, = Open3.capture2e("timeout", "10", ADB_BIN, "devices")
  output.lines.any? { |line| line.split.first == serial }
end

def process_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
end

def log_tail(path, lines = 30)
  File.exist?(path) ? File.readlines(path).last(lines).join : "(no log written)"
end
