# Aborts the commit if Spotless finds formatting violations.
# Enable once per clone with: git config core.hooksPath .githooks

if ! ./gradlew --quiet spotlessCheck; then
    echo 1>&2 ""
    echo 1>&2 "Commit aborted: Spotless found formatting violations."
    echo 1>&2 "Run './gradlew spotlessApply', stage the changes and commit again."
    exit 1
fi
